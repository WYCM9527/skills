{
  "$schema": "https://raw.githubusercontent.com/WYCM9527/Design-System/main/design-system-adopter/schema/design-system.schema.json",
  "id": "{{ID}}",
  "name": "{{NAME}}",
  "version": "{{VERSION}}",
  "description": "{{DESCRIPTION}}",
  "upstream": {
    "repo": "{{REPO}}",
    "path": "{{PATH}}",
    "tagPrefix": "{{ID}}-v",
    "npm": "{{NPM}}"
  },
  "docs": {
    "design": "design-system/DESIGN.md",
    "changelog": "CHANGELOG.md",
    "readme": "README.md"
  },
  "stacks": {
    "css": {
      "label": "纯 CSS（任意栈）",
      "entry": "bridge/base.css",
      "extra": [],
      "snippet": "templates/entry-css.css",
      "notes": "templates/notes-css.md",
      "detect": {
        "files": []
      }
    }
  },
  "export": {
    "note": "纯 CSS 交付：非 Node 项目用 ds.mjs export --to <static 目录> 得到 index.css + base.css，按顺序 <link>，项目样式只引用变量。",
    "core": [
      "design-system/dist/index.css",
      "bridge/base.css"
    ],
    "optional": {},
    "usage": "<link rel=\"stylesheet\" href=\"index.css\">  <!-- token（默认模式）+ 其他模式 delta -->\n<link rel=\"stylesheet\" href=\"base.css\">   <!-- 基础桥接：body / 标题 / 链接 / 表单控件 / 焦点 / 减少动态效果 -->\n<link rel=\"stylesheet\" href=\"你的样式.css\">  <!-- 只引用 var(--color-*) / var(--spacing-*) 等变量，不写色值与像素 -->"
  },
  "agents": "templates/AGENTS.md",
  "build": {
    "tool": "style-dictionary@5.5.2",
    "steward": "design-system-steward"
  },
  "owned": [
    "design-system/DESIGN.md",
    "design-system/AUDIT.md",
    "design-system/style-dictionary.config.mjs",
    "design-system/scope-map.json",
    "design-system/theme-map.json",
    "design-system/tokens/**",
    "design-system/themes/**",
    "bridge/**",
    "templates/**"
  ]
}
